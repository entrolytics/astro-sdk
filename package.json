{
  "name": "@entrolytics/astro-sdk",
  "version": "3.0.1",
  "description": "Astro SDK for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "astro",
    "astro-integration",
    "entrolytics",
    "form-analytics",
    "tracking",
    "web-analytics",
    "web-vitals"
  ],
  "homepage": "https://entrolytics.click",
  "bugs": {
    "url": "https://github.com/entrolytics/astro-sdk/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.click>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/astro-sdk",
    "directory": "entro-astro"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsc --emitDeclarationOnly --noEmit false",
    "check": "vp check",
    "dev": "vp pack --watch",
    "format": "vp fmt --write .",
    "lint": "vp lint --fix . && vp fmt --write .",
    "lint:check": "vp lint . && vp fmt --check .",
    "lint:fix-unsafe": "vp lint -f stylish --import-plugin --type-aware --type-check --fix --fix-suggestions --fix-dangerously src/",
    "prepublishOnly": "vp run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.0.1"
  },
  "devDependencies": {
    "astro": "^7.3.1",
    "typescript": "next",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "astro": ">=6.4.2"
  },
  "peerDependenciesMeta": {
    "web-vitals": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "web-vitals": "^6.2.1"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.26.0"
}
