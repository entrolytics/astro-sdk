{
  "name": "@entrolytics/astro-sdk",
  "version": "3.0.3",
  "description": "Astro SDK for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "astro",
    "astro-integration",
    "entrolytics",
    "form-analytics",
    "tracking",
    "web-analytics"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/astro-sdk/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/astro-sdk",
    "directory": "entro-astro"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --noEmit false",
    "check": "tsc --noEmit",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:check": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --fix --fix-suggestions --fix-dangerously src/",
    "prepublishOnly": "pnpm build",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.2.1"
  },
  "devDependencies": {
    "astro": "^7.4.13",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsdown": "^0.23.7",
    "typescript": "next"
  },
  "peerDependencies": {
    "astro": ">=6.4.2"
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "packageManager": "pnpm@12.24.0"
}
